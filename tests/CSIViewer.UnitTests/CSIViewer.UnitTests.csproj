<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CSIViewer.Core\CSIViewer.Core.csproj" />
    <ProjectReference Include="..\..\src\CSIViewer.Protocol\CSIViewer.Protocol.csproj" />
    <ProjectReference Include="..\..\src\CSIViewer.Security\CSIViewer.Security.csproj" />
    <ProjectReference Include="..\..\src\CSIViewer.Application\CSIViewer.Application.csproj" />
    <ProjectReference Include="..\..\src\CSIViewer.Networking\CSIViewer.Networking.csproj" />
    <ProjectReference Include="..\..\src\CSIViewer.Infrastructure\CSIViewer.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CSIViewer.Media\CSIViewer.Media.csproj" />
    <ProjectReference Include="..\..\src\CSIViewer.Services\CSIViewer.Services.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exercise the real headless server sources without launching WinUI/SCM. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <Compile Include="../../src/CSIViewer.Server/ServerHost.cs" Link="Server/ServerHost.cs" />
    <Compile Include="../../src/Shared/ProtectedInstallation.cs" Link="Server/ProtectedInstallation.cs" />
    <Compile Include="../../src/CSIViewer.Server/ServerRuntimeSettings.cs" Link="Server/ServerRuntimeSettings.cs" />
    <Compile Include="../../src/CSIViewer.Server/ServerDataPaths.cs" Link="Server/ServerDataPaths.cs" />
    <Compile Include="../../src/CSIViewer.Server/ServerDataPermissions.cs" Link="Server/ServerDataPermissions.cs" />
    <Compile Include="../../src/CSIViewer.Server/ServerSettingsStore.cs" Link="Server/ServerSettingsStore.cs" />
    <Compile Include="../../src/CSIViewer.Server/ServerServiceManager.cs" Link="Server/ServerServiceManager.cs" />
    <Compile Include="../../src/CSIViewer.Server/ServerCommandLine.cs" Link="Server/ServerCommandLine.cs" />
    <Compile Include="../../src/CSIViewer.Server/ServerServiceLog.cs" Link="Server/ServerServiceLog.cs" />
    <Compile Include="../../src/CSIViewer.Server/UpnpPortMapper.cs" Link="Server/UpnpPortMapper.cs" />
    <Compile Include="../../src/CSIViewer.Server/StunServerService.cs" Link="Server/StunServerService.cs" />
    <Compile Include="../../src/CSIViewer.Server/DeviceRegistry.cs" Link="Server/DeviceRegistry.cs" />
    <Compile Include="../../src/CSIViewer.Server/RegistrationThrottle.cs" Link="Server/RegistrationThrottle.cs" />
    <Compile Include="../../src/CSIViewer.Server/Persistence/*.cs" Link="Server/Persistence/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/CSIViewer.Media/WindowsGraphicsCapture.cs" LogicalName="UiContracts.media.WgcCode" />
    <EmbeddedResource Include="../../src/CSIViewer/Views/FileTransferPage.xaml" LogicalName="UiContracts.viewer.Files" />
    <EmbeddedResource Include="../../src/CSIViewer/Themes/Colors.xaml" LogicalName="UiContracts.viewer.Colors" />
    <EmbeddedResource Include="../../src/CSIViewer/MainWindow.xaml" LogicalName="UiContracts.viewer.Main" />
    <EmbeddedResource Include="../../src/CSIViewer/Views/ContactsPage.xaml.cs" LogicalName="UiContracts.viewer.ContactsCode" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Views/ContactsPage.xaml.cs" LogicalName="UiContracts.host.ContactsCode" />
    <EmbeddedResource Include="../../src/CSIViewer/Views/RemoteControlPage.xaml.cs" LogicalName="UiContracts.viewer.SessionCode" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Views/RemoteControlPage.xaml.cs" LogicalName="UiContracts.host.SessionCode" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/MainWindow.xaml" LogicalName="UiContracts.host.Main" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Themes/Colors.xaml" LogicalName="UiContracts.host.Colors" />
    <EmbeddedResource Include="../../src/CSIViewer/Views/RemoteControlPage.xaml" LogicalName="UiContracts.viewer.Session" />
    <EmbeddedResource Include="../../src/CSIViewer/Views/DevicesPage.xaml" LogicalName="UiContracts.viewer.Devices" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Views/FileTransferPage.xaml" LogicalName="UiContracts.host.Files" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Views/RemoteControlPage.xaml" LogicalName="UiContracts.host.Session" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Views/DevicesPage.xaml" LogicalName="UiContracts.host.Devices" />
    <EmbeddedResource Include="../../src/CSIViewer/Views/ChatPage.xaml" LogicalName="UiContracts.viewer.Chat" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Views/ChatPage.xaml" LogicalName="UiContracts.host.Chat" />
    <EmbeddedResource Include="../../src/CSIViewer/Views/ContactsPage.xaml" LogicalName="UiContracts.viewer.Contacts" />
    <EmbeddedResource Include="../../src/CSIViewer.Host/Views/ContactsPage.xaml" LogicalName="UiContracts.host.Contacts" />
  </ItemGroup>
</Project>
