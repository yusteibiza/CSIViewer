<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Inicio" Style="{StaticResource PageTitleStyle}" loc:Translate.Text="Inicio" />
                    <TextBlock Text="Comparte tu ID y contraseña temporal para recibir asistencia." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Comparte tu ID y contraseña temporal para recibir asistencia." />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Click="Connect_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="" />
                        <TextBlock Text="Conectar a otro equipo" loc:Translate.Text="Conectar a otro equipo" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Este equipo" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Este equipo" />
                            <TextBlock x:Name="DeviceNameText" Text="—" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="ID DE ESTE EQUIPO" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="ID DE ESTE EQUIPO" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="DeviceIdText" Text="—" FontSize="34" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" AutomationProperties.AutomationId="ViewerDeviceId" />
                                <Button x:Name="CopyIdButton" Click="CopyId_Click" ToolTipService.ToolTip="Copiar ID" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Copiar ID">
                                    <FontIcon Glyph="" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="CONTRASEÑA TEMPORAL" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="CONTRASEÑA TEMPORAL" />
                            <TextBlock x:Name="PasswordText" Text="—" FontSize="26" FontWeight="SemiBold" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AutomationId="ViewerPassword" />
                            <loc:WrapPanel Spacing="6">
                                <Button x:Name="RevealPasswordButton" Click="RevealPassword_Click" ToolTipService.ToolTip="Mostrar u ocultar" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Mostrar u ocultar">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                                <Button Click="CopyPassword_Click" ToolTipService.ToolTip="Copiar contraseña" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Copiar contraseña">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                                <Button Click="RegeneratePassword_Click" ToolTipService.ToolTip="Generar una nueva contraseña" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Generar una nueva contraseña">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                                <Button Click="ChangePassword_Click" ToolTipService.ToolTip="Usar una contraseña propia" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="ChangePasswordButton" loc:Translate.ToolTip="Usar una contraseña propia">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                            </loc:WrapPanel>
                            <TextBlock x:Name="PasswordExpiryText" Text="" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="La contraseña se verifica en este equipo. El servidor nunca la recibe." Style="{StaticResource MutedTextStyle}" FontSize="12" loc:Translate.Text="La contraseña se verifica en este equipo. El servidor nunca la recibe." />
                        </StackPanel>

                        <ToggleSwitch x:Name="AllowIncomingSwitch" Header="Permitir conexiones entrantes" Toggled="AllowIncoming_Toggled" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Permitir conexiones entrantes" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowSpacing="16" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Estado" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Estado" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource OfflineBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ServerStatusText" Text="Sin conexión" FontWeight="SemiBold" loc:Translate.Text="Sin conexión" />
                            </StackPanel>
                            <TextBlock x:Name="StatusMessageText" Text="Iniciando…" Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Iniciando…" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Huella de identidad" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="Huella de identidad" />
                                <TextBlock x:Name="FingerprintText" Text="—" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Content="Configuración" Click="OpenSettings_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Configuración" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="8" VerticalAlignment="Top">
                            <TextBlock Text="Sesión actual" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Sesión actual" />
                            <TextBlock x:Name="SessionText" Text="No hay ninguna sesión activa." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="No hay ninguna sesión activa." />
                            <Button x:Name="EndSessionButton" Content="Finalizar sesión" Click="EndSession_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Finalizar sesión" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Actividad reciente" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Actividad reciente" />
                    <ListView x:Name="RecentHistoryList" MaxHeight="240" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding RemoteName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RemoteDeviceId}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StartedUtc}" HorizontalAlignment="Right" FontSize="12" />
                                        <TextBlock Text="{Binding Result}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoHistoryText" Text="Todavía no hay conexiones registradas." Style="{StaticResource MutedTextStyle}" Visibility="Collapsed" loc:Translate.Text="Todavía no hay conexiones registradas." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
