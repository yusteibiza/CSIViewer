<Page
    x:Class="CSIViewer.Views.HostSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20,10" MaxWidth="740" Spacing="8" HorizontalAlignment="Center">
            <StackPanel Spacing="1">
                <TextBlock Text="Configuración del host" Style="{StaticResource PageTitleStyle}" FontSize="22" />
                <TextBlock Text="Tema, servidor, calidad de imagen y modo desatendido."
                           Style="{StaticResource MutedTextStyle}" FontSize="12" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Apariencia" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tema" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectionChanged="ThemeCombo_SelectionChanged"
                                      AutomationProperties.AutomationId="HostThemeCombo">
                                <ComboBoxItem Content="Tema del sistema" Tag="System" />
                                <ComboBoxItem Content="Tema claro" Tag="Light" />
                                <ComboBoxItem Content="Tema oscuro" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                        <ComboBox x:Name="AccentColorCombo" Header="Color de énfasis" HorizontalAlignment="Stretch"
                                  SelectionChanged="AccentColorCombo_SelectionChanged" AutomationProperties.AutomationId="HostAccentColorCombo">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="14" Height="14" Fill="{Binding PreviewColor}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Servidor" Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="ServerUrlBox"
                                 PlaceholderText="URL del servidor (http://localhost:5080)"
                                 AutomationProperties.AutomationId="HostServerUrlBox" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Guardar" Click="SaveServer_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="HostSaveServerButton" />
                            <Button Content="Probar" Click="TestServer_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="HostTestServerButton" />
                        </StackPanel>
                        <TextBlock x:Name="ServerStatusText" Text="" Style="{StaticResource MutedTextStyle}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Calidad de imagen" Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Guardar" Click="SaveQuality_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="HostSaveQualityButton" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Calidad" VerticalAlignment="Center" />
                            <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="20" Maximum="95"
                                    StepFrequency="1" AutomationProperties.AutomationId="HostQualitySlider" />
                            <TextBlock x:Name="QualityValueText" Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FPS" VerticalAlignment="Center" />
                            <ComboBox x:Name="FpsCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="HostFpsCombo" />
                            <TextBlock Grid.Column="2" Text="objetivo" VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}" FontSize="12" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ancho" VerticalAlignment="Center" />
                            <Slider x:Name="MaxWidthSlider" Grid.Column="1" Minimum="640" Maximum="2560"
                                    StepFrequency="80" AutomationProperties.AutomationId="HostMaxWidthSlider" />
                            <TextBlock x:Name="MaxWidthValueText" Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch x:Name="H264Switch" Header="H.264" OffContent="JPEG"
                                          AutomationProperties.AutomationId="HostH264Switch" />
                            <ToggleSwitch x:Name="ModernCaptureSwitch" Grid.Column="1"
                                          Header="Captura moderna" OffContent="GDI"
                                          AutomationProperties.AutomationId="HostModernCaptureSwitch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Modo desatendido" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Arranca con Windows y recibe conexiones sin abrir la aplicación. Requiere UAC."
                                   Style="{StaticResource MutedTextStyle}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="UnattendedBusyRing" Width="18" Height="18" IsActive="False"
                                          Visibility="Collapsed" />
                            <TextBlock x:Name="UnattendedStatusText" Text="Comprobando."
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="HostUnattendedStatus" />
                        </StackPanel>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="InstallUnattendedButton" Content="Instalar"
                                    Click="InstallUnattended_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    AutomationProperties.AutomationId="HostInstallUnattendedButton" />
                            <Button x:Name="UninstallUnattendedButton" Content="Desinstalar"
                                    Grid.Column="1" Click="UninstallUnattended_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="HostUninstallUnattendedButton" />
                            <Button Content="Actualizar estado" Grid.Row="1" Grid.ColumnSpan="2"
                                    Click="RefreshUnattended_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    AutomationProperties.AutomationId="HostRefreshUnattendedButton" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
