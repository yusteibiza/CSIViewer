<Page
    x:Class="CSIViewer.Views.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBackgroundBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="20,14" MaxWidth="660" HorizontalAlignment="Center" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Conectar con el ID de CSIViewer" Style="{StaticResource PageTitleStyle}"
                               FontSize="22" />
                    <TextBlock Text="Para iniciar una sesión, usa estas credenciales."
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="SettingsButton" Click="OpenSettings_Click"
                        Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Configuración"
                        AutomationProperties.AutomationId="HostSettingsButton"
                        AutomationProperties.Name="Configuración">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="20" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="TU ID" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="DeviceIdText" Text="-" FontSize="34" FontWeight="SemiBold"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="HostDeviceId" />
                                <Button x:Name="CopyIdButton" Click="CopyId_Click"
                                        ToolTipService.ToolTip="Copiar ID"
                                        AutomationProperties.Name="Copiar ID"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="PasswordText" Text="-" FontSize="24" FontWeight="SemiBold"
                                       FontFamily="Consolas" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="HostPassword" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="RevealPasswordButton" Click="RevealPassword_Click"
                                        ToolTipService.ToolTip="Mostrar u ocultar"
                                        AutomationProperties.Name="Mostrar u ocultar contraseña"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                </Button>
                                <Button Click="CopyPassword_Click" ToolTipService.ToolTip="Copiar contraseña"
                                        AutomationProperties.Name="Copiar contraseña"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                                <Button Click="RegeneratePassword_Click"
                                        ToolTipService.ToolTip="Generar una nueva contraseña"
                                        AutomationProperties.Name="Generar una nueva contraseña"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="PasswordExpiryText" Text="" Style="{StaticResource MutedTextStyle}"
                                       FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource BrandSoftBrush}" CornerRadius="6" Padding="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8AF;" FontSize="20" VerticalAlignment="Center"
                                      Foreground="{ThemeResource BrandBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Permitir control de este equipo" FontWeight="SemiBold" />
                                <TextBlock Text="Comparte tu ID y contraseña solo con quien confíes."
                                           Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="AllowIncomingSwitch"
                                          Toggled="AllowIncoming_Toggled"
                                          AutomationProperties.AutomationId="HostAllowIncoming" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                     Fill="{ThemeResource OfflineBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="StatusText" Text="Iniciando…" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusDetailText" Text=""
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ChangePasswordButton" Click="ChangePassword_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="HostChangePasswordButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="Cambiar contraseña" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sesión actual" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="SessionText" Text="No hay ninguna sesión activa."
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="EndSessionButton" Content="Finalizar sesión"
                            Click="EndSession_Click" Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="False" AutomationProperties.AutomationId="HostEndSessionButton" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="La contraseña se verifica en este equipo. El servidor nunca la recibe."
                       Style="{StaticResource MutedTextStyle}" FontSize="12" />
        </Grid>
    </ScrollViewer>
</Page>
