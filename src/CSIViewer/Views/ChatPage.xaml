<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Views.ChatPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Chat" Style="{StaticResource PageTitleStyle}" loc:Translate.Text="Chat" />
            <TextBlock Text="Mensajería cifrada con el equipo remoto durante la sesión." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Mensajería cifrada con el equipo remoto durante la sesión." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="ChatDeviceCombo" Header="Dispositivo" HorizontalAlignment="Stretch" SelectionChanged="ChatDevice_SelectionChanged" AutomationProperties.AutomationId="ChatDeviceCombo" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Dispositivo" />
            <Button x:Name="ExportChatButton" Grid.Column="1" Content="Exportar chat" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButtonStyle}" Click="ExportChat_Click" AutomationProperties.AutomationId="ExportChatButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Exportar chat" />
            <Button x:Name="DeleteChatButton" Grid.Column="2" Content="Borrar chat" VerticalAlignment="Bottom" Style="{StaticResource DangerButtonStyle}" Click="DeleteChat_Click" AutomationProperties.AutomationId="DeleteChatButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Borrar chat" />
        </Grid>

        <InfoBar x:Name="ChatStatusBar" Grid.Row="2" IsOpen="False" Severity="Informational" IsClosable="False" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <ListView x:Name="ChatList" SelectionMode="None" Padding="16" VerticalAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,4">
                            <Border HorizontalAlignment="Left" MaxWidth="560" CornerRadius="12" Background="{ThemeResource ChatReceivedBrush}" Padding="12,8" Visibility="{Binding ReceivedVisibility}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Left" MaxWidth="560" CornerRadius="12" Margin="28,0,0,0" Background="{ThemeResource ChatSentBrush}" Padding="12,8" Visibility="{Binding SentVisibility}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="EmojiButton" Grid.Column="0" Content="😊" FontSize="18" Width="40" Height="34" Padding="0" ToolTipService.ToolTip="Añadir emoji" AutomationProperties.Name="Añadir emoji" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.ToolTip="Añadir emoji" loc:Translate.AutomationName="Añadir emoji">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <StackPanel Width="340" Spacing="8">
                        <ComboBox x:Name="EmojiCategoryCombo" HorizontalAlignment="Stretch" SelectionChanged="EmojiCategory_SelectionChanged" AutomationProperties.AutomationId="EmojiCategoryCombo" AutomationProperties.Name="Categoría de emojis" loc:Translate.AutomationName="Categoría de emojis" />
                        <GridView x:Name="EmojiGrid" SelectionMode="None" Width="340" Height="240" Padding="4" AutomationProperties.AutomationId="EmojiGrid">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Click="Emoji_Click" Width="36" MinWidth="0" Height="36" Padding="0" FontSize="20" FontFamily="Segoe UI Emoji" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBox x:Name="MessageBox" Grid.Column="1" PlaceholderText="Escribe un mensaje…" MaxLength="8000" KeyDown="MessageBox_KeyDown" AutomationProperties.AutomationId="ChatMessageInput" loc:Translate.PlaceholderText="Escribe un mensaje…" />
            <Button x:Name="SendButton" Grid.Column="2" Content="Enviar" Style="{StaticResource PrimaryButtonStyle}" Click="Send_Click" AutomationProperties.AutomationId="ChatSendButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Enviar" />
        </Grid>
    </Grid>
</Page>
