<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Views.ContactsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="Contactos" Style="{StaticResource PageTitleStyle}" loc:Translate.Text="Contactos" />
                <TextBlock Text="Personas que agrupan varios equipos. Pulsa un equipo vinculado para conectarte." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Personas que agrupan varios equipos. Pulsa un equipo vinculado para conectarte." />
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="Añadir contacto" Click="AddContact_Click" Style="{StaticResource PrimaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Añadir contacto" />
        </Grid>

        <InfoBar x:Name="ContactsStatusBar" Grid.Row="1" IsOpen="False" Severity="Informational" IsClosable="True" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ListView x:Name="ContactsList" SelectionMode="None" Padding="12">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="16" Background="Transparent" CornerRadius="4" loc:RowHover.Brush="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource BrandBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="" FontSize="14" Margin="0,0,6,0" Foreground="{ThemeResource BrandBrush}" Visibility="{Binding FavoriteVisibility}" AutomationProperties.Name="Favorito" loc:Translate.AutomationName="Favorito" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Details}" Visibility="{Binding DetailsVisibility}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Details}" />
                                    <TextBlock Text="{Binding Notes}" Visibility="{Binding NotesVisibility}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Notes}" />
                                    <Border Background="{ThemeResource LinkedDeviceBackgroundBrush}" CornerRadius="4" Padding="8,3" Margin="0,6,0,4" HorizontalAlignment="Left">
                                        <TextBlock Text="Equipos vinculados" Foreground="{ThemeResource LinkedDeviceForegroundBrush}" FontSize="12" FontWeight="SemiBold" loc:Translate.Text="Equipos vinculados" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><loc:WrapPanel Spacing="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Alias}" Click="ConnectDevice_Click" MinHeight="32" Padding="12,5" FontSize="13" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" ToolTipService.ToolTip="{Binding DeviceId}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Sin dispositivos vinculados" Style="{StaticResource MutedTextStyle}" FontSize="12" Visibility="{Binding EmptyVisibility}" loc:Translate.Text="Sin dispositivos vinculados" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Editar" MinWidth="96" MinHeight="28" Padding="10,4" FontSize="12" HorizontalAlignment="Stretch" Click="Edit_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="EditContactButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Editar" />
                                    <Button Content="Eliminar" MinWidth="96" MinHeight="28" Padding="10,4" FontSize="12" HorizontalAlignment="Stretch" Click="Delete_Click" Style="{StaticResource DangerButtonStyle}" AutomationProperties.AutomationId="DeleteContactButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Eliminar" />
                                </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
