<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Fallback neutro; Windows elige Light/Dark según el tema del sistema. -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="BrandBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#173B52" />
            <SolidColorBrush x:Key="ChatSentBrush" Color="#123E5A" />
            <SolidColorBrush x:Key="ChatReceivedBrush" Color="#333333" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0A0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Keep the navigation pane neutral instead of showing wallpaper-tinted Mica. -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F3F3F3" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F3F3F3" />
            <SolidColorBrush x:Key="BrandBrush" Color="#0067C0" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#E8F4FF" />
            <SolidColorBrush x:Key="ChatSentBrush" Color="#D7ECFF" />
            <SolidColorBrush x:Key="ChatReceivedBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#5F5F5F" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BrandBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#173B52" />
            <SolidColorBrush x:Key="ChatSentBrush" Color="#123E5A" />
            <SolidColorBrush x:Key="ChatReceivedBrush" Color="#333333" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0A0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ChatSentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChatReceivedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnlineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OfflineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <x:Double x:Key="CardSpacing">14</x:Double>
</ResourceDictionary>
