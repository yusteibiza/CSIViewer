<?xml version="1.0" encoding="utf-8"?><Window x:Class="CSIViewer.Host.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="CSIViewer" xmlns:loc="using:CSIViewer.Presentation">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Solo título y zona de arrastre. Los botones de ventana del sistema
             se dibujan a la derecha y no deben quedar tapados por controles. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,150,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="" FontSize="17" Foreground="{ThemeResource BrandBrush}" />
                <TextBlock x:Name="AppTitleText" Text="CSIViewer" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" loc:Translate.Text="CSIViewer" />
            </StackPanel>
        </Grid>

        <!-- Barra de estado fuera de la barra de título, para no invadir los
             botones minimizar/maximizar/cerrar. -->
        <Grid x:Name="StatusBarRow" Grid.Row="1" Padding="20,0,20,0" Background="{ThemeResource PageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="HostBackButton" Visibility="Collapsed" Width="30" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Click="HostBack_Click" ToolTipService.ToolTip="Volver al inicio del host" AutomationProperties.AutomationId="HostBackButton" AutomationProperties.Name="Volver al inicio del host" loc:Translate.ToolTip="Volver al inicio del host" loc:Translate.AutomationName="Volver al inicio del host">
                    <FontIcon Glyph="" FontSize="14" />
                </Button>
                <TextBlock x:Name="TopBarHintText" Text="Asistencia y control remoto" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" loc:Translate.Text="Asistencia y control remoto" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                <Border Style="{StaticResource StatusPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="TopStatusDot" Width="8" Height="8" Fill="{ThemeResource OfflineBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ServerStatusText" Text="Sin conexión" FontSize="12" loc:Translate.Text="Sin conexión" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="DeviceIdHeaderText" Text="ID —" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" FontFamily="Consolas" FontSize="12" loc:Translate.Text="ID —" />
                <Button x:Name="ThemeButton" Width="34" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Cambiar tema" loc:Translate.ToolTip="Cambiar tema">
                    <FontIcon Glyph="" FontSize="15" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Tema claro" Tag="Light" Click="ThemeMenuItem_Click" loc:Translate.Text="Tema claro" />
                            <MenuFlyoutItem Text="Tema oscuro" Tag="Dark" Click="ThemeMenuItem_Click" loc:Translate.Text="Tema oscuro" />
                            <MenuFlyoutItem Text="Tema del sistema" Tag="System" Click="ThemeMenuItem_Click" loc:Translate.Text="Tema del sistema" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Width="34" Height="30" ToolTipService.ToolTip="Color de énfasis" AutomationProperties.Name="Color de énfasis" AutomationProperties.AutomationId="AccentColorButton" loc:Translate.ToolTip="Color de énfasis" loc:Translate.AutomationName="Color de énfasis">
                    <FontIcon Glyph="" FontSize="15" Foreground="{ThemeResource BrandBrush}" />
                    <Button.Flyout><MenuFlyout x:Name="AccentMenu" /></Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="SessionBanner" Grid.Row="2" Severity="Success" IsOpen="False" Title="Sesión remota activa" Message="Hay una sesión remota en curso." IsClosable="False" Margin="16,0,16,8" loc:Translate.Title="Sesión remota activa" loc:Translate.Message="Hay una sesión remota en curso.">
            <InfoBar.ActionButton>
                <Button Content="Finalizar sesión" Click="EndSession_Click" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Finalizar sesión" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView x:Name="NavView" Grid.Row="3" Style="{StaticResource NavigationViewStyle}" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <!-- Avoid a second light border/rounded corner around remote content. -->
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Inicio" Tag="home" loc:Translate.Content="Inicio">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Control remoto" Tag="remote" AutomationProperties.AutomationId="NavRemote" loc:Translate.Content="Control remoto">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dispositivos" Tag="devices" loc:Translate.Content="Dispositivos">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Transferencia de archivos" Tag="files" AutomationProperties.AutomationId="NavFiles" loc:Translate.Content="Transferencia de archivos">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Chat" Tag="chat" loc:Translate.Content="Chat">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Historial" Tag="history" loc:Translate.Content="Historial">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Contactos" Tag="contacts" loc:Translate.Content="Contactos">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ayuda" Tag="help" AutomationProperties.AutomationId="NavHelp" loc:Translate.Content="Ayuda">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Configuración" Tag="settings" loc:Translate.Content="Configuración">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Acerca de" Tag="about" loc:Translate.Content="Acerca de">
                    <NavigationViewItem.Icon><FontIcon Glyph="" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Ventana del host: un contenido propio a pantalla completa, sin la
             navegación del cliente. -->
        <Frame x:Name="HostFrame" Grid.Row="3" Visibility="Collapsed" />
    </Grid>
</Window>
