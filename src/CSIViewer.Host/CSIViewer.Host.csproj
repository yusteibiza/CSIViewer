<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>CSIViewer.Host</AssemblyName>
    <RootNamespace>CSIViewer.Host</RootNamespace>
    <DefineConstants>$(DefineConstants);CSIVIEWER_HOST</DefineConstants>
    <ApplicationIcon>Assets\Appicon.ico</ApplicationIcon>
    <AssemblyTitle>CSIViewer Host</AssemblyTitle>
    <Product>CSIViewer Host</Product>
    <Description>CSIViewer Host - ventana autónoma de anfitrión</Description>
    <Company>CSIViewer</Company>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType Condition="'$(PackageMsix)' != 'true'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(PackageMsix)' != 'true'">true</WindowsAppSDKSelfContained>
    <EnableMsixTooling Condition="'$(PackageMsix)' == 'true'">true</EnableMsixTooling>
    <EnableMsixTooling Condition="'$(PackageMsix)' != 'true'">false</EnableMsixTooling>
    <AppxPackageName Condition="'$(PackageMsix)' == 'true'">CSIViewer.Host</AppxPackageName>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild Condition="'$(PackageMsix)' == 'true'">true</GenerateAppxPackageOnBuild>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageMsix)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackageMsix)' != 'true'">
    <Content Include="Assets\Appicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CSIViewer.Core\CSIViewer.Core.csproj" />
    <Compile Include="..\Shared\AccentAppearance.cs" Link="Presentation\AccentAppearance.cs" />
    <Compile Include="..\Shared\Translate.cs" Link="Presentation\Translate.cs" />
    <Compile Include="..\Shared\WrapPanel.cs" Link="Presentation\WrapPanel.cs" />
    <Compile Include="..\CSIViewer\MainWindow.Accent.cs" Link="MainWindow.Accent.cs" />
    <Compile Include="..\CSIViewer\Views\HostSettingsPage.Accent.cs" Link="Views\HostSettingsPage.Accent.cs" />
    <!-- Shared browser logic is compiled into this independent executable. -->
    <Compile Include="..\CSIViewer\Views\FileTransferPage.Browser.cs" Link="Views\FileTransferPage.Browser.cs" />
    <ProjectReference Include="..\CSIViewer.Application\CSIViewer.Application.csproj" />
    <ProjectReference Include="..\CSIViewer.Services\CSIViewer.Services.csproj" />
  </ItemGroup>
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIXbf Include="$(TargetDir)*.xbf" />
      <_WinUIResourcePri Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIXbf)" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIResourcePri)" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
