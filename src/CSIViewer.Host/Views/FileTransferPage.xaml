<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Host.Views.FileTransferPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <Page.Resources>
        <DataTemplate x:Key="FileBrowserTemplate">
            <Grid Padding="4,5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FullPath}" />
                <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource MutedTextStyle}" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Transferencia de archivos" Style="{StaticResource PageTitleStyle}" loc:Translate.Text="Transferencia de archivos" />
            <TextBlock Text="Selecciona archivos o carpetas y usa Enviar o Recibir. Doble clic para abrir carpetas." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" loc:Translate.Text="Selecciona archivos o carpetas y usa Enviar o Recibir. Doble clic para abrir carpetas." />
        </StackPanel>

        <InfoBar x:Name="TransferStatusBar" Grid.Row="2" IsOpen="False" Severity="Informational" IsClosable="True" />

        <Grid Grid.Row="3" ColumnSpacing="10" MinHeight="180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Este equipo" FontWeight="SemiBold" loc:Translate.Text="Este equipo" />
                    <TextBox x:Name="LocalPathBox" Grid.Row="1" PlaceholderText="Ruta local" KeyDown="LocalPath_KeyDown" AutomationProperties.AutomationId="LocalFilePath" loc:Translate.PlaceholderText="Ruta local" />
                    <loc:WrapPanel Grid.Row="2" Spacing="4">
                        <Button Content="Unidades" Click="LocalRoots_Click" Padding="8,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Unidades" />
                        <Button Click="LocalUp_Click" MinWidth="32" Height="30" Padding="8,4" ToolTipService.ToolTip="Subir" AutomationProperties.Name="Subir" AutomationProperties.AutomationId="LocalFileUp" loc:Translate.ToolTip="Subir" loc:Translate.AutomationName="Subir"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                        <Button Click="LocalGo_Click" MinWidth="32" Height="30" Padding="8,4" ToolTipService.ToolTip="Ir" AutomationProperties.Name="Ir" AutomationProperties.AutomationId="LocalFileGo" loc:Translate.ToolTip="Ir" loc:Translate.AutomationName="Ir"><FontIcon Glyph="&#xE72A;" FontSize="14" /></Button>
                        <Button Click="LocalRefresh_Click" MinWidth="32" Height="30" Padding="8,4" ToolTipService.ToolTip="Actualizar" AutomationProperties.Name="Actualizar" AutomationProperties.AutomationId="LocalFileRefresh" loc:Translate.ToolTip="Actualizar" loc:Translate.AutomationName="Actualizar"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
                    </loc:WrapPanel>
                    <ListView x:Name="LocalFilesList" Grid.Row="3" SelectionMode="Extended" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource FileBrowserTemplate}" DoubleTapped="LocalFiles_DoubleTapped" SelectionChanged="BrowserSelection_Changed" AutomationProperties.AutomationId="LocalFilesList" />
                    <loc:WrapPanel Grid.Row="4" Spacing="6" AlignItemsVertically="True">
                        <Button x:Name="LocalPreviousButton" Content="Anterior" Click="LocalPrevious_Click" Padding="8,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Anterior" />
                        <Button x:Name="LocalNextButton" Content="Siguiente" Click="LocalNext_Click" Padding="8,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Siguiente" />
                        <TextBlock x:Name="LocalCountText" VerticalAlignment="Center" FontSize="11" />
                    </loc:WrapPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                <Button x:Name="SendSelectionButton" Content="Enviar →" Click="SendSelection_Click" AutomationProperties.AutomationId="SendSelectedFiles" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Enviar →" />
                <Button x:Name="ReceiveSelectionButton" Content="← Recibir" Click="ReceiveSelection_Click" AutomationProperties.AutomationId="ReceiveSelectedFiles" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="← Recibir" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="RemoteBrowserTitle" Text="Equipo remoto" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" loc:Translate.Text="Equipo remoto" />
                    <TextBox x:Name="RemotePathBox" Grid.Row="1" PlaceholderText="Ruta remota" KeyDown="RemotePath_KeyDown" AutomationProperties.AutomationId="RemoteFilePath" loc:Translate.PlaceholderText="Ruta remota" />
                    <loc:WrapPanel Grid.Row="2" Spacing="4">
                        <Button Content="Unidades" Click="RemoteRoots_Click" Padding="8,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Unidades" />
                        <Button Click="RemoteUp_Click" MinWidth="32" Height="30" Padding="8,4" ToolTipService.ToolTip="Subir" AutomationProperties.Name="Subir" AutomationProperties.AutomationId="RemoteFileUp" loc:Translate.ToolTip="Subir" loc:Translate.AutomationName="Subir"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                        <Button Click="RemoteGo_Click" MinWidth="32" Height="30" Padding="8,4" ToolTipService.ToolTip="Ir" AutomationProperties.Name="Ir" AutomationProperties.AutomationId="RemoteFileGo" loc:Translate.ToolTip="Ir" loc:Translate.AutomationName="Ir"><FontIcon Glyph="&#xE72A;" FontSize="14" /></Button>
                        <Button Click="RemoteRefresh_Click" MinWidth="32" Height="30" Padding="8,4" ToolTipService.ToolTip="Actualizar" AutomationProperties.Name="Actualizar" AutomationProperties.AutomationId="RemoteFileRefresh" loc:Translate.ToolTip="Actualizar" loc:Translate.AutomationName="Actualizar"><FontIcon Glyph="&#xE72C;" FontSize="14" /></Button>
                    </loc:WrapPanel>
                    <ListView x:Name="RemoteFilesList" Grid.Row="3" SelectionMode="Extended" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource FileBrowserTemplate}" DoubleTapped="RemoteFiles_DoubleTapped" SelectionChanged="BrowserSelection_Changed" AutomationProperties.AutomationId="RemoteFilesList" />
                    <loc:WrapPanel Grid.Row="4" Spacing="6" AlignItemsVertically="True">
                        <Button x:Name="RemotePreviousButton" Content="Anterior" Click="RemotePrevious_Click" Padding="8,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Anterior" />
                        <Button x:Name="RemoteNextButton" Content="Siguiente" Click="RemoteNext_Click" Padding="8,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Siguiente" />
                        <TextBlock x:Name="RemoteCountText" VerticalAlignment="Center" FontSize="11" />
                    </loc:WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12,8">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" Text="Sin transferencias activas" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" loc:Translate.Text="Sin transferencias activas" />
                    <TextBlock x:Name="SummaryDetailText" Grid.Column="1" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                </Grid>
                <ProgressBar x:Name="TotalProgressBar" Maximum="1" Height="6" />
            </StackPanel>
        </Border>

        <Expander Grid.Row="5" Header="Opciones y progreso de transferencias" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" loc:Translate.Header="Opciones y progreso de transferencias">
            <StackPanel Spacing="8">
                <loc:WrapPanel Spacing="8">
                    <Button x:Name="SendFilesButton" Content="Seleccionar archivos" Click="SendFiles_Click" Padding="10,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Seleccionar archivos" />
                    <Button x:Name="SendFolderButton" Content="Seleccionar carpeta" Click="SendFolder_Click" Padding="10,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Seleccionar carpeta" />
                    <Button Content="Abrir descargas" Click="OpenDownloadFolder_Click" Padding="10,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Abrir descargas" />
                </loc:WrapPanel>
                <loc:WrapPanel Spacing="8">
                    <Button x:Name="PauseAllButton" Content="Pausar activas" Click="PauseAll_Click" FontSize="11" Padding="10,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Pausar activas" />
                    <Button x:Name="ResumeAllButton" Content="Reanudar interrumpidas" Click="ResumeAll_Click" FontSize="11" Padding="10,4" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Reanudar interrumpidas" />
                </loc:WrapPanel>
            <ListView x:Name="TransfersList" SelectionMode="None" Padding="12" MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{Binding Progress}" Maximum="1" Height="4" />
                                <TextBlock FontSize="11" Style="{StaticResource MutedTextStyle}">
                                    <Run Text="{Binding StateText}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding TransferredBytes}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding TotalBytes}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SpeedText}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding EtaText}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock Text="{Binding DirectionText}" HorizontalAlignment="Right" FontSize="11" Style="{StaticResource MutedTextStyle}" />
                                <loc:WrapPanel Spacing="4" HorizontalAlignment="Right">
                                    <Button Content="Pausar" Click="Pause_Click" FontSize="11" Padding="8,4" IsEnabled="{Binding CanPause}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Pausar" />
                                    <Button Content="Reanudar" Click="Resume_Click" FontSize="11" Padding="8,4" IsEnabled="{Binding CanResume}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Reanudar" />
                                    <Button Content="Cancelar" Click="Cancel_Click" FontSize="11" Padding="8,4" IsEnabled="{Binding CanCancel}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Cancelar" />
                                </loc:WrapPanel>
                                <TextBlock Text="{Binding Error}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap" MaxWidth="240" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </StackPanel>
        </Expander>
    </Grid>
</Page>
