<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Host.Views.ChatPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Chat" Style="{StaticResource PageTitleStyle}" loc:Translate.Text="Chat" />
            <TextBlock Text="Mensajería cifrada con el equipo remoto durante la sesión." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Mensajería cifrada con el equipo remoto durante la sesión." />
        </StackPanel>

        <InfoBar x:Name="ChatStatusBar" Grid.Row="1" IsOpen="False" Severity="Informational" IsClosable="False" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ListView x:Name="ChatList" SelectionMode="None" Padding="16" VerticalAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,4">
                            <Border HorizontalAlignment="Left" MaxWidth="560" CornerRadius="12" Background="{ThemeResource ChatReceivedBrush}" Padding="12,8" Visibility="{Binding ReceivedVisibility}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Left" MaxWidth="560" CornerRadius="12" Margin="28,0,0,0" Background="{ThemeResource ChatSentBrush}" Padding="12,8" Visibility="{Binding SentVisibility}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding MetaText}" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="EmojiButton" Grid.Column="0" Content="😊" FontSize="18" Width="40" Height="34" Padding="0" ToolTipService.ToolTip="Añadir emoji" AutomationProperties.Name="Añadir emoji" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.ToolTip="Añadir emoji" loc:Translate.AutomationName="Añadir emoji">
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <GridView x:Name="EmojiGrid" SelectionMode="None" Width="300" Height="190" Padding="4">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Click="Emoji_Click" Width="34" Height="34" Padding="0" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBox x:Name="MessageBox" Grid.Column="1" PlaceholderText="Escribe un mensaje…" MaxLength="8000" KeyDown="MessageBox_KeyDown" loc:Translate.PlaceholderText="Escribe un mensaje…" />
            <Button Grid.Column="2" Content="Enviar" Style="{StaticResource PrimaryButtonStyle}" Click="Send_Click" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Enviar" />
        </Grid>
    </Grid>
</Page>
