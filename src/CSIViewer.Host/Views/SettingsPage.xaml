<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Host.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <Page.Resources>
        <Style x:Key="DropdownItemButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Configuración" Style="{StaticResource PageTitleStyle}" loc:Translate.Text="Configuración" />
                <TextBlock Text="Apariencia, servidor, calidad de imagen, archivos y privacidad." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Apariencia, servidor, calidad de imagen, archivos y privacidad." />
            </StackPanel>

            <InfoBar x:Name="SettingsStatusBar" IsOpen="False" Severity="Informational" IsClosable="True" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Apariencia" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Apariencia" />
                    <Grid ColumnSpacing="20" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tema" VerticalAlignment="Center" loc:Translate.Text="Tema" />
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="220" SelectionChanged="ThemeCombo_SelectionChanged" AutomationProperties.AutomationId="ThemeCombo">
                            <ComboBoxItem Content="Tema del sistema" Tag="System" loc:Translate.Content="Tema del sistema" />
                            <ComboBoxItem Content="Tema claro" Tag="Light" loc:Translate.Content="Tema claro" />
                            <ComboBoxItem Content="Tema oscuro" Tag="Dark" loc:Translate.Content="Tema oscuro" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Color de énfasis" VerticalAlignment="Center" loc:Translate.Text="Color de énfasis" />
                        <ComboBox x:Name="AccentColorCombo" Grid.Column="1" MinWidth="220" SelectionChanged="AccentColorCombo_SelectionChanged" AutomationProperties.AutomationId="AccentColorCombo">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="14" Height="14" Fill="{Binding PreviewColor}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Idioma" VerticalAlignment="Center" loc:Translate.Text="Idioma" />
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="220" DisplayMemberPath="NativeName" SelectionChanged="LanguageCombo_SelectionChanged" AutomationProperties.AutomationId="LanguageCombo" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Servidor y equipo" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Servidor y equipo" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="NOMBRE DEL EQUIPO" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="NOMBRE DEL EQUIPO" />
                        <TextBox x:Name="DeviceNameBox" MaxLength="80" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="URL DEL SERVIDOR" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="URL DEL SERVIDOR" />
                        <TextBox x:Name="ServerUrlBox" PlaceholderText="http://localhost:5080" loc:Translate.PlaceholderText="http://localhost:5080" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="CÓDIGO DE INSCRIPCIÓN" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="CÓDIGO DE INSCRIPCIÓN" />
                        <TextBox x:Name="EnrollmentCodeBox" PlaceholderText="DEV-1234" MaxLength="128" loc:Translate.PlaceholderText="DEV-1234" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Guardar y reconectar" Click="SaveAndReconnect_Click" Style="{StaticResource PrimaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Guardar y reconectar" />
                        <TextBlock x:Name="ServerHintText" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Sin conexión" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Modo desatendido" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Modo desatendido" />
                    <TextBlock Text="La tarea programada CSIViewerHost inicia el agente al arrancar Windows. Cuando hay una sesión de usuario, el agente abre CSIViewer.Host.exe. No se instala un servicio de Windows." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" loc:Translate.Text="La tarea programada CSIViewerHost inicia el agente al arrancar Windows. Cuando hay una sesión de usuario, el agente abre CSIViewer.Host.exe. No se instala un servicio de Windows." />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Estado del servicio:" VerticalAlignment="Center" loc:Translate.Text="Estado del servicio:" />
                        <TextBlock x:Name="UnattendedStatusText" Text="Comprobando…" FontWeight="SemiBold" VerticalAlignment="Center" loc:Translate.Text="Comprobando…" />
                        <ProgressRing x:Name="UnattendedBusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        <Button x:Name="InstallUnattendedButton" Content="Instalar servicio" Click="InstallUnattended_Click" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="InstallUnattendedButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Instalar servicio" />
                        <Button x:Name="UninstallUnattendedButton" Content="Desinstalar" Click="UninstallUnattended_Click" Style="{StaticResource DangerButtonStyle}" AutomationProperties.AutomationId="UninstallUnattendedButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Desinstalar" />
                        <Button Content="Actualizar estado" Click="RefreshUnattended_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="RefreshUnattendedButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Actualizar estado" />
                    </StackPanel>
                    <TextBlock Text="La instalación solicita permisos de administrador (UAC). El servicio arranca con Windows y lanza el cliente en la sesión del usuario. Al activarlo se desactiva «Iniciar con Windows» del cliente para no duplicar el arranque." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" loc:Translate.Text="La instalación solicita permisos de administrador (UAC). El servicio arranca con Windows y lanza el cliente en la sesión del usuario. Al activarlo se desactiva «Iniciar con Windows» del cliente para no duplicar el arranque." />
                    <TextBlock Text="Limitación de Windows: la pantalla de inicio de sesión y el escritorio seguro de UAC no se capturan sin un componente UIAccess firmado. El modo desatendido funciona en la sesión del usuario iniciada." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" loc:Translate.Text="Limitación de Windows: la pantalla de inicio de sesión y el escritorio seguro de UAC no se capturan sin un componente UIAccess firmado. El modo desatendido funciona en la sesión del usuario iniciada." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Calidad de imagen" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Calidad de imagen" />
                    <Grid ColumnSpacing="20" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Calidad JPEG" VerticalAlignment="Center" loc:Translate.Text="Calidad JPEG" />
                        <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="20" Maximum="95" StepFrequency="1" />
                        <TextBlock x:Name="QualityValueText" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FPS objetivo" VerticalAlignment="Center" loc:Translate.Text="FPS objetivo" />
                        <ComboBox x:Name="FpsCombo" Grid.Column="1" Width="150" HorizontalAlignment="Left" AutomationProperties.AutomationId="FpsCombo" ToolTipService.ToolTip="Frecuencia de captura objetivo" loc:Translate.ToolTip="Frecuencia de captura objetivo" />
                        <TextBlock Grid.Column="2" Text="FPS" VerticalAlignment="Center" loc:Translate.Text="FPS" />
                    </Grid>
                    <TextBlock Text="50, 60, 90 y 120 FPS requieren un monitor compatible, CPU/GPU suficiente y una red rápida. Si el codificador no puede seguir el ritmo, se descartan frames para mantener la sesión estable." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" loc:Translate.Text="50, 60, 90 y 120 FPS requieren un monitor compatible, CPU/GPU suficiente y una red rápida. Si el codificador no puede seguir el ritmo, se descartan frames para mantener la sesión estable." />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ancho máximo" VerticalAlignment="Center" loc:Translate.Text="Ancho máximo" />
                        <Slider x:Name="MaxWidthSlider" Grid.Column="1" Minimum="640" Maximum="2560" StepFrequency="80" />
                        <TextBlock x:Name="MaxWidthValueText" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                    <ToggleSwitch x:Name="ModernCaptureSwitch" Header="Usar Windows.Graphics.Capture (recomendado)" OffContent="Usar captura GDI de respaldo" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Usar Windows.Graphics.Capture (recomendado)" OnContent="Activado" loc:Translate.OffContent="Usar captura GDI de respaldo" loc:Translate.OnContent="Activado" />
                    <ToggleSwitch x:Name="H264Switch" Header="Usar H.264 con Media Foundation (recomendado)" OffContent="Usar JPEG" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Usar H.264 con Media Foundation (recomendado)" OnContent="Activado" loc:Translate.OffContent="Usar JPEG" loc:Translate.OnContent="Activado" />
                    <ToggleSwitch x:Name="DirectLanSwitch" Header="Intentar conexión directa por LAN" OffContent="Usar siempre el relay del servidor" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Intentar conexión directa por LAN" OnContent="Activado" loc:Translate.OffContent="Usar siempre el relay del servidor" loc:Translate.OnContent="Activado" />
                    <TextBlock Text="La captura usa Windows.Graphics.Capture + H.264 Media Foundation con fallback JPEG y GDI. La aceleración hardware del códec se valida en la matriz de GPU." Style="{StaticResource MutedTextStyle}" FontSize="12" loc:Translate.Text="La captura usa Windows.Graphics.Capture + H.264 Media Foundation con fallback JPEG y GDI. La aceleración hardware del códec se valida en la matriz de GPU." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Archivos" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Archivos" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="CARPETA DE DESCARGAS" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="CARPETA DE DESCARGAS" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DownloadFolderBox" />
                            <Button Grid.Column="1" Content="Examinar" Click="BrowseDownloadFolder_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Examinar" />
                        </Grid>
                    </StackPanel>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Si el archivo ya existe" VerticalAlignment="Center" loc:Translate.Text="Si el archivo ya existe" />
                        <ComboBox x:Name="FileConflictCombo" Grid.Column="1" MinWidth="260" HorizontalAlignment="Left" AutomationProperties.AutomationId="FileConflictCombo">
                            <ComboBoxItem Content="Renombrar automáticamente" Tag="Rename" loc:Translate.Content="Renombrar automáticamente" />
                            <ComboBoxItem Content="Sobrescribir" Tag="Overwrite" loc:Translate.Content="Sobrescribir" />
                            <ComboBoxItem Content="Omitir" Tag="Skip" loc:Translate.Content="Omitir" />
                        </ComboBox>
                    </Grid>
                    <ToggleSwitch x:Name="AutoResumeTransfersSwitch" Header="Reanudar transferencias interrumpidas al reconectar" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Reanudar transferencias interrumpidas al reconectar" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Límite de subida (KB/s, 0 = sin límite)" VerticalAlignment="Center" loc:Translate.Text="Límite de subida (KB/s, 0 = sin límite)" />
                        <NumberBox x:Name="UploadLimitBox" Grid.Column="1" Minimum="0" Maximum="1000000" SpinButtonPlacementMode="Inline" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Comportamiento" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Comportamiento" />
                    <ToggleSwitch x:Name="AllowIncomingSwitch" Header="Permitir conexiones entrantes" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Permitir conexiones entrantes" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Máximo de clientes simultáneos" VerticalAlignment="Center" loc:Translate.Text="Máximo de clientes simultáneos" />
                        <NumberBox x:Name="MaxSessionsBox" Grid.Column="1" Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="MaxSessionsBox" />
                    </Grid>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Caducidad de la contraseña temporal (min, 0 = sin caducidad)" VerticalAlignment="Center" TextWrapping="Wrap" loc:Translate.Text="Caducidad de la contraseña temporal (min, 0 = sin caducidad)" />
                        <NumberBox x:Name="TemporaryPasswordLifetimeBox" Grid.Column="1" Minimum="0" Maximum="1440" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="TemporaryPasswordLifetimeBox" />
                    </Grid>
                    <ToggleSwitch x:Name="AllowInsecureSwitch" Header="Permitir servidor remoto sin HTTPS (no recomendado)" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Permitir servidor remoto sin HTTPS (no recomendado)" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Header="Iniciar con Windows" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Iniciar con Windows" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                    <TextBlock Text="Abre CSIViewer al iniciar sesión. Para equipos sin nadie delante, usa el modo desatendido mediante la tarea programada CSIViewerHost." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" loc:Translate.Text="Abre CSIViewer al iniciar sesión. Para equipos sin nadie delante, usa el modo desatendido mediante la tarea programada CSIViewerHost." />
                    <ToggleSwitch x:Name="NotificationsSwitch" Header="Mostrar notificaciones" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Mostrar notificaciones" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                    <ToggleSwitch x:Name="AskFilesSwitch" Header="Confirmar antes de recibir archivos" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Confirmar antes de recibir archivos" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                    <ToggleSwitch x:Name="HistorySwitch" Header="Guardar historial de conexiones" HeaderTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Header="Guardar historial de conexiones" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Conexión y reconexión" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Conexión y reconexión" />
                    <Grid ColumnSpacing="20" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Intervalo de heartbeat (s)" VerticalAlignment="Center" loc:Translate.Text="Intervalo de heartbeat (s)" />
                        <NumberBox x:Name="HeartbeatIntervalBox" Grid.Row="0" Grid.Column="1" Minimum="2" Maximum="120" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="HeartbeatIntervalBox" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Timeout de heartbeat (s)" VerticalAlignment="Center" loc:Translate.Text="Timeout de heartbeat (s)" />
                        <NumberBox x:Name="HeartbeatTimeoutBox" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="600" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="HeartbeatTimeoutBox" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Timeout de conexión (s)" VerticalAlignment="Center" loc:Translate.Text="Timeout de conexión (s)" />
                        <NumberBox x:Name="ConnectTimeoutBox" Grid.Row="2" Grid.Column="1" Minimum="3" Maximum="60" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="ConnectTimeoutBox" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Reintentos máximos (0 = ilimitado)" VerticalAlignment="Center" loc:Translate.Text="Reintentos máximos (0 = ilimitado)" />
                        <NumberBox x:Name="ReconnectRetriesBox" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="ReconnectRetriesBox" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Retardo inicial (s)" VerticalAlignment="Center" loc:Translate.Text="Retardo inicial (s)" />
                        <NumberBox x:Name="ReconnectInitialDelayBox" Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="ReconnectInitialDelayBox" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Retardo máximo (s)" VerticalAlignment="Center" loc:Translate.Text="Retardo máximo (s)" />
                        <NumberBox x:Name="ReconnectMaxDelayBox" Grid.Row="5" Grid.Column="1" Minimum="1" Maximum="600" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="ReconnectMaxDelayBox" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Jitter (%)" VerticalAlignment="Center" loc:Translate.Text="Jitter (%)" />
                        <NumberBox x:Name="ReconnectJitterBox" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="50" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="ReconnectJitterBox" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Timeout de mensaje (s)" VerticalAlignment="Center" loc:Translate.Text="Timeout de mensaje (s)" />
                        <NumberBox x:Name="MessageTimeoutBox" Grid.Row="7" Grid.Column="1" Minimum="10" Maximum="300" SpinButtonPlacementMode="Inline" Width="140" AutomationProperties.AutomationId="MessageTimeoutBox" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Diagnóstico de red" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Diagnóstico de red" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nivel de detalle de logs" VerticalAlignment="Center" loc:Translate.Text="Nivel de detalle de logs" />
                        <DropDownButton x:Name="LogLevelButton" Grid.Column="1" MinWidth="300" MinHeight="40" Padding="12,0" HorizontalContentAlignment="Left" HorizontalAlignment="Left" AutomationProperties.AutomationId="LogLevelCombo">
                            <DropDownButton.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft" Opened="LogLevelFlyout_Opened">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MaxWidth" Value="360" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Width="300" Padding="4" Spacing="2">
                                        <Button x:Name="DebugLevelItem" Tag="Debug" Style="{StaticResource DropdownItemButtonStyle}" Click="LogLevelItem_Click">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="DebugLevelBar" Width="3" Height="18" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                                <TextBlock Grid.Column="1" Text="Depuración (máximo detalle)" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" loc:Translate.Text="Depuración (máximo detalle)" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="InformationLevelItem" Tag="Information" Style="{StaticResource DropdownItemButtonStyle}" Click="LogLevelItem_Click">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="InformationLevelBar" Width="3" Height="18" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                                <TextBlock Grid.Column="1" Text="Información" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" loc:Translate.Text="Información" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="WarningLevelItem" Tag="Warning" Style="{StaticResource DropdownItemButtonStyle}" Click="LogLevelItem_Click">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="WarningLevelBar" Width="3" Height="18" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                                <TextBlock Grid.Column="1" Text="Advertencia" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" loc:Translate.Text="Advertencia" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="ErrorLevelItem" Tag="Error" Style="{StaticResource DropdownItemButtonStyle}" Click="LogLevelItem_Click">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ErrorLevelBar" Width="3" Height="18" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                                <TextBlock Grid.Column="1" Text="Error" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" loc:Translate.Text="Error" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="CriticalLevelItem" Tag="Critical" Style="{StaticResource DropdownItemButtonStyle}" Click="LogLevelItem_Click">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="CriticalLevelBar" Width="3" Height="18" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                                <TextBlock Grid.Column="1" Text="Crítico" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" loc:Translate.Text="Crítico" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <loc:WrapPanel Spacing="10">
                        <Button Content="Probar servidor" Click="TestServer_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Probar servidor" />
                        <Button Content="Probar STUN" Click="TestStun_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Probar STUN" />
                        <Button Content="Exportar diagnóstico" Click="ExportDiagnostics_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Exportar diagnóstico" />
                    </loc:WrapPanel>
                    <TextBlock x:Name="DiagnosticsText" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <loc:WrapPanel Spacing="10">
                <Button Content="Guardar configuración" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Guardar configuración" />
                <Button Content="Revocar todo el acceso" Click="RevokeAll_Click" Style="{StaticResource DangerButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Revocar todo el acceso" />
                <Button Content="Abrir carpeta de logs" Click="OpenLogs_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Abrir carpeta de logs" />
            </loc:WrapPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
