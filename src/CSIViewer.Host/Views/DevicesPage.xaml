<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Host.Views.DevicesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Dispositivos" Style="{StaticResource PageTitleStyle}" loc:Translate.Text="Dispositivos" />
                <TextBlock Text="Equipos guardados, favoritos y listas personalizadas como Clientes o Casa." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" loc:Translate.Text="Equipos guardados, favoritos y listas personalizadas como Clientes o Casa." />
            </StackPanel>
            <loc:WrapPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <Button Content="Listas" Click="ManageLists_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="ManageListsButton" ToolTipService.ToolTip="Crear, renombrar o eliminar listas personalizadas" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Listas" loc:Translate.ToolTip="Crear, renombrar o eliminar listas personalizadas" />
                <Button Content="Nuevo dispositivo" Click="NewDevice_Click" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="NewDeviceButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Nuevo dispositivo" />
            </loc:WrapPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ID DEL EQUIPO REMOTO" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="ID DEL EQUIPO REMOTO" />
                    <TextBox x:Name="DirectIdBox" PlaceholderText="123 456 789" MaxLength="11" FontFamily="Consolas" AutomationProperties.AutomationId="DirectIdBox" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CONTRASEÑA TEMPORAL" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="CONTRASEÑA TEMPORAL" />
                    <PasswordBox x:Name="DirectPasswordBox" PlaceholderText="Contraseña" AutomationProperties.AutomationId="DirectPasswordBox" loc:Translate.PlaceholderText="Contraseña" />
                </StackPanel>
                <Button Grid.Column="2" Content="Conectar" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Click="ConnectHost_Click" AutomationProperties.AutomationId="DirectConnectButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Conectar" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Buscar por nombre, ID, descripción o lista…" TextChanged="SearchBox_TextChanged" AutomationProperties.AutomationId="DeviceSearchBox" loc:Translate.PlaceholderText="Buscar por nombre, ID, descripción o lista…" />
            <ComboBox x:Name="ListFilterBox" Grid.Column="1" MinWidth="210" DisplayMemberPath="Name" SelectionChanged="ListFilter_SelectionChanged" AutomationProperties.AutomationId="ListFilterBox" ToolTipService.ToolTip="Filtrar dispositivos por lista" loc:Translate.ToolTip="Filtrar dispositivos por lista" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <ListView x:Name="DevicesList" SelectionMode="None" Padding="12">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,10" ColumnSpacing="12" Background="Transparent" CornerRadius="4" loc:RowHover.Brush="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10" Background="{ThemeResource BrandSoftBrush}">
                                    <FontIcon Glyph="" FontSize="20" Foreground="{ThemeResource BrandBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Alias}" />
                                    </Grid>
                                    <TextBlock Text="{Binding DeviceId}" FontFamily="Consolas" FontSize="12" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="{Binding DescriptionVisibility}" />
                                    <TextBlock Text="{Binding LastSeenText}" FontSize="11" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="" FontSize="12" Foreground="{ThemeResource BrandBrush}" Visibility="{Binding FavoriteVisibility}" ToolTipService.ToolTip="Favorito" loc:Translate.ToolTip="Favorito" />
                                    <Border Background="{ThemeResource BrandSoftBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="{Binding ListVisibility}">
                                        <TextBlock Text="{Binding ListName}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource BrandBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                    </Border>
                                </StackPanel>
                                <loc:WrapPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="Conectar" Click="Connect_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Conectar" />
                                    <Button Content="Editar" Click="Edit_Click" Style="{StaticResource SecondaryButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Editar" />
                                    <Button Content="Eliminar" Click="Delete_Click" Style="{StaticResource DangerButtonStyle}" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Eliminar" />
                                </loc:WrapPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="" FontSize="34" Foreground="{ThemeResource MutedTextBrush}" />
                    <TextBlock Text="No hay dispositivos que mostrar" FontWeight="SemiBold" HorizontalAlignment="Center" loc:Translate.Text="No hay dispositivos que mostrar" />
                    <TextBlock Text="Crea uno con «Nuevo dispositivo» o cambia el filtro." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" loc:Translate.Text="Crea uno con «Nuevo dispositivo» o cambia el filtro." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
