<?xml version="1.0" encoding="utf-8"?><Page x:Class="CSIViewer.Host.Views.HostPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackgroundBrush}" xmlns:loc="using:CSIViewer.Presentation">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="20,14" MaxWidth="660" HorizontalAlignment="Center" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Conectar con el ID de CSIViewer" Style="{StaticResource PageTitleStyle}" FontSize="22" loc:Translate.Text="Conectar con el ID de CSIViewer" />
                    <TextBlock Text="Para iniciar una sesión, usa estas credenciales." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="Para iniciar una sesión, usa estas credenciales." />
                </StackPanel>
                <loc:WrapPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="HelpButton" Click="OpenHelp_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Ayuda" AutomationProperties.AutomationId="HostHelpButton" AutomationProperties.Name="Ayuda" loc:Translate.ToolTip="Ayuda" loc:Translate.AutomationName="Ayuda">
                        <FontIcon Glyph="" FontSize="15" />
                    </Button>
                    <Button x:Name="SettingsButton" Click="OpenSettings_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Configuración" AutomationProperties.AutomationId="HostSettingsButton" AutomationProperties.Name="Configuración" loc:Translate.ToolTip="Configuración" loc:Translate.AutomationName="Configuración">
                        <FontIcon Glyph="" FontSize="15" />
                    </Button>
                </loc:WrapPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="20" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="TU ID" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="TU ID" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="DeviceIdText" Text="-" FontSize="34" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" AutomationProperties.AutomationId="HostDeviceId" />
                                <Button x:Name="CopyIdButton" Click="CopyId_Click" ToolTipService.ToolTip="Copiar ID" AutomationProperties.Name="Copiar ID" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Copiar ID" loc:Translate.AutomationName="Copiar ID">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabelStyle}" loc:Translate.Text="CONTRASEÑA" />
                            <TextBlock x:Name="PasswordText" Text="-" FontSize="24" FontWeight="SemiBold" FontFamily="Consolas" TextWrapping="Wrap" AutomationProperties.AutomationId="HostPassword" />
                            <loc:WrapPanel Spacing="6">
                                <Button x:Name="RevealPasswordButton" Click="RevealPassword_Click" ToolTipService.ToolTip="Mostrar u ocultar" AutomationProperties.Name="Mostrar u ocultar contraseña" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Mostrar u ocultar" loc:Translate.AutomationName="Mostrar u ocultar contraseña">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                                <Button Click="CopyPassword_Click" ToolTipService.ToolTip="Copiar contraseña" AutomationProperties.Name="Copiar contraseña" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Copiar contraseña" loc:Translate.AutomationName="Copiar contraseña">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                                <Button Click="RegeneratePassword_Click" ToolTipService.ToolTip="Generar una nueva contraseña" AutomationProperties.Name="Generar una nueva contraseña" Style="{StaticResource SecondaryButtonStyle}" loc:Translate.ToolTip="Generar una nueva contraseña" loc:Translate.AutomationName="Generar una nueva contraseña">
                                    <FontIcon Glyph="" FontSize="14" />
                                </Button>
                            </loc:WrapPanel>
                            <TextBlock x:Name="PasswordExpiryText" Text="" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource BrandSoftBrush}" CornerRadius="6" Padding="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource BrandBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Permitir control de este equipo" FontWeight="SemiBold" loc:Translate.Text="Permitir control de este equipo" />
                                <TextBlock Text="Comparte tu ID y contraseña solo con quien confíes." Style="{StaticResource MutedTextStyle}" FontSize="12" loc:Translate.Text="Comparte tu ID y contraseña solo con quien confíes." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="AllowIncomingSwitch" Toggled="AllowIncoming_Toggled" AutomationProperties.AutomationId="HostAllowIncoming" OnContent="Activado" OffContent="Desactivado" loc:Translate.OnContent="Activado" loc:Translate.OffContent="Desactivado" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource OfflineBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="StatusText" Text="Iniciando…" FontWeight="SemiBold" loc:Translate.Text="Iniciando…" />
                                <TextBlock x:Name="StatusDetailText" Text="" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ChangePasswordButton" Click="ChangePassword_Click" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="HostChangePasswordButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="" FontSize="14" />
                                <TextBlock Text="Cambiar contraseña" loc:Translate.Text="Cambiar contraseña" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sesión actual" Style="{StaticResource SectionTitleStyle}" loc:Translate.Text="Sesión actual" />
                        <TextBlock x:Name="SessionText" Text="No hay ninguna sesión activa." Style="{StaticResource MutedTextStyle}" loc:Translate.Text="No hay ninguna sesión activa." />
                    </StackPanel>
                    <loc:WrapPanel Grid.Column="1" Spacing="8">
                        <Button x:Name="ChatButton" Content="Chat" Click="OpenChat_Click" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" AutomationProperties.AutomationId="HostChatButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Chat" />
                        <Button x:Name="EndSessionButton" Content="Finalizar sesión" Click="EndSession_Click" Style="{StaticResource DangerButtonStyle}" IsEnabled="False" AutomationProperties.AutomationId="HostEndSessionButton" ContentTemplate="{StaticResource WrappedLabelTemplate}" loc:Translate.Content="Finalizar sesión" />
                    </loc:WrapPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="La contraseña se verifica en este equipo. El servidor nunca la recibe." Style="{StaticResource MutedTextStyle}" FontSize="12" loc:Translate.Text="La contraseña se verifica en este equipo. El servidor nunca la recibe." />
        </Grid>
    </ScrollViewer>
</Page>
